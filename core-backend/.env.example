# Copy to .env and fill in. Never commit the real .env.

# HTTP server
PORT=4000

# Postgres (Sequelize). Use a full connection URL.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/university_rag

# Auth (JWT)
JWT_SECRET=dev-jwt-secret-change-me
JWT_EXPIRES_IN=7d

# RAG engine (Python FastAPI) — internal, not exposed to the browser
RAG_ENGINE_URL=http://localhost:8000
RAG_INTERNAL_KEY=dev-internal-key-change-me
RAG_TIMEOUT_MS=30000

# Knowledge-base admin
RAG_UPLOAD_TIMEOUT_MS=120000
MAX_UPLOAD_MB=50
# First admin account, created (or promoted) at startup. Leave empty to skip.
ADMIN_EMAIL=admin@must.edu.mn
ADMIN_PASSWORD=change-me-now

# Frontend origin allowed by CORS
CORS_ORIGIN=http://localhost:3000
